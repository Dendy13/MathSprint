# ============================================
# MathSprint Backend — Environment Variables
# ============================================
# Copy file ini ke .env dan isi dengan nilai yang benar.
# JANGAN commit .env ke repository!

# Firebase
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173,https://mathsprint-447876034135.asia-southeast2.run.app

# App
ENVIRONMENT=development
PORT=8080

# Developer Account (UID Firebase pertama yang dibuat manual)
INITIAL_DEVELOPER_UID=
